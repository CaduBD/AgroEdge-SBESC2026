# Login da plataforma (usuário único criado no seed)
ADMIN_NOME=Equipe AgroEdge
ADMIN_EMAIL=equipe@agroedge.local
ADMIN_SENHA=troque-esta-senha

# Sessão
SESSION_SECRET=gere-um-valor-aleatorio-longo

# Token de serviço do chatbot (seção 10.1); vazio = sem acesso por token
CHATBOT_TOKEN=gere-um-token-aleatorio-longo
CORS_ORIGENS=

# Banco
DATABASE_URL=sqlite+aiosqlite:////data/agroedge.db

# Broker (o backend fala com o broker pela rede do compose)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USUARIO=plataforma
MQTT_SENHA=gere-uma-senha
MQTT_TLS=false

# Placa padrão (criada pelo seed; o simulador usa estes valores)
DISPOSITIVO_SERIAL=agroedge-00001
DISPOSITIVO_SENHA=gere-outra-senha

# O que mostrar na tela "Como conectar a placa" (IP do notebook no hotspot)
BROKER_HOST_PUBLICO=172.20.10.10
TZ_EXIBICAO=America/Bahia
