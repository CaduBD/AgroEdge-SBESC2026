# Copie para chatbot/.env e preencha. O .env não vai para o git.

# Plataforma AgroEdge (CHATBOT.md, seções 1 e 6)
#   sua plataforma local com o simulador: http://localhost:8000
#   a do notebook da equipe pelo Tailscale: http://100.x.y.z:8000
AGROEDGE_API_URL=http://localhost:8000
# A linha CHATBOT_TOKEN= do plataforma/.env da plataforma escolhida
AGROEDGE_TOKEN=

# Telegram: token que o @BotFather entrega ao criar o bot
TELEGRAM_BOT_TOKEN=
# Quem pode usar o bot não fica aqui: cada produtor conecta o Telegram pelo painel
# (Conta → Telegram → Conectar Telegram → QR code).
# Só se a rede exigir proxy para sair (ex.: http://usuario:senha@proxy.univ.br:3128)
TELEGRAM_PROXY=

# Alertas automáticos: diario (meia-noite), status (placa caiu/voltou), irrigacao
BOT_ALERTAS=diario,status,irrigacao

# Arquivo onde o bot lembra o cultivo escolhido e os alertas já enviados
BOT_ARQUIVO_ESTADO=estado_bot.json

# Fuso de exibição (Petrolina/Juazeiro: UTC−3)
BOT_FUSO=America/Bahia
